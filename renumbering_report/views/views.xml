<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="renumbering_report_report">
        <t t-call="web.html_container">
            <t t-set="doc" t-value="docs and docs[0]"/>
            <t t-if="doc">
                <div class="page" style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
                    <div class="header" style="border-bottom: 2px solid #2c3e50; padding-bottom: 20px; margin-bottom: 30px;">
                        <div class="row">
                            <div class="col-xs-6">
                                <!-- <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 80px;" /> -->
                                <div style="font-size: 24px; font-weight: bold; color: #2c3e50;">
                                    Alif Holdings
                                </div>
                            </div>
                         
                        </div>
                    </div>
                    <div class="content">
                        <div class="subject" style="margin-bottom: 30px;">
                            <h3 style="color: #2c3e50; margin: 0;">Subject: Good News – Update in Your Unit Number</h3>
                        </div>
                        <div class="salutation" style="margin-bottom: 20px;">
                            <p>Dear
                                <t t-if="doc.old_file_id and doc.old_file_id.partner_id">
                                    <strong><span t-field="doc.old_file_id.partner_id.name" /></strong>,
                                </t>
                                <t t-else="">
                                    <strong>Valued Customer</strong>,
                                </t>
                            </p>
                        </div>
                        <div class="introduction" style="margin-bottom: 25px;">
                            <p>
                                We are pleased to inform you that as part of our ongoing project enhancement, the unit layout and
                                numbering have been revised to align with the updated master plan and overall development
                                improvements.
                            </p>
                        </div>
                        <!-- Unit Details Section -->
                        <div class="unit-details" style="margin-bottom: 25px;">
                            <p>Accordingly, your unit details have been updated as follows:</p>
                            <t t-foreach="docs" t-as="cc">
                                <div style="margin: 10px 0; padding: 10px; background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 5px;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="width: 40%; padding: 12px 0; font-weight: bold; color: #2c3e50;">Previous Unit Number:</td>
                                            <td style="padding: 12px 0;">
                                                <span t-field="cc.old_file_name" style="font-weight: bold; color: #dc3545; font-size: 16px;" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 12px 0; font-weight: bold; color: #2c3e50;">New Unit Number:</td>
                                            <td style="padding: 12px 0;">
                                                <span t-field="cc.new_file_name" style="font-weight: bold; color: #28a745; font-size: 16px;" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </t>
                        </div>
                        <!-- Additional Information -->
                        <div class="additional-info" style="margin-bottom: 25px;">
                            <p>
                                This revision has been introduced to ensure a more organized layout and enhanced value across the
                                project. Please note that your ownership and all associated terms remain fully intact.
                            </p>
                        </div>
                        <!-- Appreciation -->
                        <div class="appreciation" style="margin-bottom: 40px;">
                            <p>
                                We truly appreciate your understanding and continued trust in us.
                            </p>
                        </div>
                        <!-- Signature Section -->
                        <div class="signature" style="margin-top: 60px;">
                            <p style="margin-bottom: 5px;"><strong>Warm regards,</strong></p>
                            <p style="font-size: 18px; font-weight: bold; color: #2c3e50; margin-bottom: 20px;">Alif Holdings</p>
                        </div>
                    </div>
                    <!-- Footer -->
                    <div class="footer" style="margin-top: 50px; padding-top: 20px; border-top: 2px solid #2c3e50; text-align: center; font-size: 10px; color: #999;">
                        <p>
                            <!-- <t t-if="doc.company_id.name">
									<span t-field="doc.company_id.name"/> | 
								</t> -->
                            This is an automated notification. Please do not reply to this email.
                        </p>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
